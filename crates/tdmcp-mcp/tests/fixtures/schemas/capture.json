{
  "$defs": {
    "CaptureMode": {
      "description": "Capture mode.",
      "oneOf": [
        {
          "const": "top",
          "description": "TOP → PNG (native `saveByteArray`; retains alpha).",
          "type": "string"
        },
        {
          "const": "preview",
          "description": "Any family → shared bridge OP Viewer TOP (`capture_viewer`).",
          "type": "string"
        },
        {
          "const": "auto",
          "description": "TOP → top; CHOP → chop_data; everything else → preview.",
          "type": "string"
        },
        {
          "const": "chop_data",
          "description": "CHOP → capped JSON (no image).",
          "type": "string"
        },
        {
          "const": "pop_data",
          "description": "POP → capped columnar attribute samples (no image).",
          "type": "string"
        },
        {
          "const": "chop_image",
          "description": "Alias of `preview` (shared OP Viewer); kept for existing callers.",
          "type": "string"
        },
        {
          "const": "pop",
          "description": "Alias of `preview` (shared OP Viewer); kept for existing callers.",
          "type": "string"
        }
      ]
    },
    "DiagnosticLevel": {
      "description": "Payload size for diagnostics (independent of structural `detailLevel`).",
      "oneOf": [
        {
          "const": "summary",
          "description": "Codes, messages, capped lints, mitigation.",
          "type": "string"
        },
        {
          "const": "detailed",
          "description": "Plus raw traceback / full TD dumps.",
          "type": "string"
        }
      ]
    },
    "OpPath": {
      "description": "Operator path string passed to TD for resolution via `td.op()`.",
      "type": "string"
    },
    "Pid": {
      "description": "OS process id — sole address for tools and queues.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "additionalProperties": false,
  "description": "Args for capture (perception).",
  "properties": {
    "attrs": {
      "default": null,
      "description": "Point attribute names for `pop_data` (default `P` when present).",
      "items": {
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "contextPath": {
      "anyOf": [
        {
          "$ref": "#/$defs/OpPath"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Resolution base for relative `path`."
    },
    "diagnosticLevel": {
      "$ref": "#/$defs/DiagnosticLevel",
      "default": "summary",
      "description": "Diagnostic payload size (`summary` omits raw traceback)."
    },
    "maxSize": {
      "default": 256,
      "description": "Longer-side pixel cap before PNG encode. `null` = native resolution.\nDefaults to 256.",
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "mode": {
      "$ref": "#/$defs/CaptureMode",
      "default": "auto",
      "description": "Capture mode."
    },
    "path": {
      "$ref": "#/$defs/OpPath",
      "description": "Operator path (OpPath; relative to contextPath or /project1)."
    },
    "pid": {
      "$ref": "#/$defs/Pid",
      "description": "Target pid."
    }
  },
  "required": [
    "pid",
    "path"
  ],
  "type": "object"
}
