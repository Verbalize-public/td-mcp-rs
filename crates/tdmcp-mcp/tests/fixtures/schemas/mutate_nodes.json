{
  "$defs": {
    "DetailLevel": {
      "description": "Structural detail level.",
      "oneOf": [
        {
          "const": "summary",
          "description": "Direct-child roster as `{name, opType}` (capped at 96; see `node.truncation`).",
          "type": "string"
        },
        {
          "const": "detailed",
          "description": "Direct-child roster as `{path, family, opType}` (same 96 cap — does not uncap).",
          "type": "string"
        }
      ]
    },
    "DiagnosticLevel": {
      "description": "Payload size for diagnostics (independent of structural `detailLevel`).",
      "oneOf": [
        {
          "const": "summary",
          "description": "Codes, messages, capped lints, mitigation.",
          "type": "string"
        },
        {
          "const": "detailed",
          "description": "Plus raw traceback / full TD dumps.",
          "type": "string"
        }
      ]
    },
    "MutateStep": {
      "description": "One ordered mutate step (`create` / `set` / `delete` / `connect` / `disconnect`).",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Create a node at `path` with the given `opType`.",
          "properties": {
            "flags": {
              "additionalProperties": true,
              "description": "Direct OP attribute writes (`node.<name> = val`); allowlist = TD Common Flags subset, see CONTRACT.md.",
              "type": [
                "object",
                "null"
              ]
            },
            "op": {
              "const": "create",
              "type": "string"
            },
            "opType": {
              "description": "TD op class name (e.g. `noiseTOP`).",
              "type": "string"
            },
            "path": {
              "$ref": "#/$defs/OpPath",
              "description": "Desired node path (absolute or relative to contextPath)."
            },
            "values": {
              "additionalProperties": true,
              "description": "Plain parameter values (`.par.*` only — direct OP attributes like `display`/`viewer` go in `flags`, not here).",
              "type": [
                "object",
                "null"
              ]
            }
          },
          "required": [
            "op",
            "path",
            "opType"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Set values / expressions / pulse / flags on an existing node.",
          "properties": {
            "expressions": {
              "additionalProperties": true,
              "description": "Expression strings; mode is set to expression before assign.",
              "type": [
                "object",
                "null"
              ]
            },
            "flags": {
              "additionalProperties": true,
              "description": "Direct OP attribute writes (`node.<name> = val`); allowlist = TD Common Flags subset, see CONTRACT.md.",
              "type": [
                "object",
                "null"
              ]
            },
            "op": {
              "const": "set",
              "type": "string"
            },
            "path": {
              "$ref": "#/$defs/OpPath",
              "description": "Target node path."
            },
            "pulse": {
              "description": "Parameter names to pulse.",
              "items": {
                "type": "string"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "values": {
              "additionalProperties": true,
              "description": "Plain parameter values (`.par.*` only — direct OP attributes like `display`/`viewer` go in `flags`, not here).",
              "type": [
                "object",
                "null"
              ]
            }
          },
          "required": [
            "op",
            "path"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Destroy a node.",
          "properties": {
            "op": {
              "const": "delete",
              "type": "string"
            },
            "path": {
              "$ref": "#/$defs/OpPath",
              "description": "Target node path."
            }
          },
          "required": [
            "op",
            "path"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Wire `src` output connector to `dst` input connector.",
          "properties": {
            "dst": {
              "$ref": "#/$defs/OpPath",
              "description": "Destination operator path."
            },
            "dstInput": {
              "default": 0,
              "description": "Destination input connector index (default 0).",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "op": {
              "const": "connect",
              "type": "string"
            },
            "src": {
              "$ref": "#/$defs/OpPath",
              "description": "Source operator path."
            },
            "srcOutput": {
              "default": 0,
              "description": "Source output connector index (default 0).",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "op",
            "src",
            "dst"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Clear an input connector on `path`.",
          "properties": {
            "input": {
              "default": 0,
              "description": "Input connector index to clear (default 0).",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "op": {
              "const": "disconnect",
              "type": "string"
            },
            "path": {
              "$ref": "#/$defs/OpPath",
              "description": "Target operator path (destination side)."
            }
          },
          "required": [
            "op",
            "path"
          ],
          "type": "object"
        }
      ]
    },
    "OpPath": {
      "description": "Operator path string passed to TD for resolution via `td.op()`.",
      "type": "string"
    },
    "Pid": {
      "description": "OS process id — sole address for tools and queues.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "additionalProperties": false,
  "description": "Args for mutate_nodes.",
  "properties": {
    "contextPath": {
      "anyOf": [
        {
          "$ref": "#/$defs/OpPath"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Resolution base for relative paths."
    },
    "daemonId": {
      "default": null,
      "description": "Optional federated daemon id (omit for local / unique remote resolve).",
      "type": [
        "string",
        "null"
      ]
    },
    "detailLevel": {
      "$ref": "#/$defs/DetailLevel",
      "default": "summary",
      "description": "Structural detail level for per-step echo."
    },
    "diagnosticLevel": {
      "$ref": "#/$defs/DiagnosticLevel",
      "default": "summary",
      "description": "Diagnostic payload size (`summary` omits raw traceback)."
    },
    "exclusive": {
      "default": false,
      "description": "Ignored — bridged tools always exclusive-enqueue (kept for wire compat).",
      "type": "boolean"
    },
    "pid": {
      "$ref": "#/$defs/Pid",
      "description": "Target pid."
    },
    "steps": {
      "description": "Ordered steps; apply stops at the first hard failure.",
      "items": {
        "$ref": "#/$defs/MutateStep"
      },
      "type": "array"
    }
  },
  "required": [
    "pid",
    "steps"
  ],
  "type": "object"
}
