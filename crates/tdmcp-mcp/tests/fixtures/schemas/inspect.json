{
  "$defs": {
    "DetailLevel": {
      "description": "Structural detail level.",
      "oneOf": [
        {
          "const": "summary",
          "description": "Direct-child roster as `{name, opType}` (capped at 64; see `node.truncation`).",
          "type": "string"
        },
        {
          "const": "detailed",
          "description": "Direct-child roster as `{path, family, opType}` (same 64 cap — does not uncap).",
          "type": "string"
        }
      ]
    },
    "InspectInclude": {
      "description": "Sections to include in an inspect response.",
      "oneOf": [
        {
          "const": "nodes",
          "description": "Node tree.",
          "type": "string"
        },
        {
          "const": "params",
          "description": "Parameters.",
          "type": "string"
        },
        {
          "const": "errors",
          "description": "TD errors.",
          "type": "string"
        },
        {
          "const": "warnings",
          "description": "TD warnings.",
          "type": "string"
        }
      ]
    },
    "OpPath": {
      "description": "Operator path string passed to TD for resolution via `td.op()`.",
      "type": "string"
    },
    "Pid": {
      "description": "OS process id — sole address for tools and queues.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "additionalProperties": false,
  "description": "Args for inspect.",
  "properties": {
    "contextPath": {
      "anyOf": [
        {
          "$ref": "#/$defs/OpPath"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Resolution base for relative `path`."
    },
    "detailLevel": {
      "$ref": "#/$defs/DetailLevel",
      "default": "summary",
      "description": "Structural detail level."
    },
    "include": {
      "default": [],
      "description": "Sections to include. Empty/omitted = nodes+errors+warnings; params opt-in; non-empty = allowlist.",
      "items": {
        "$ref": "#/$defs/InspectInclude"
      },
      "type": "array"
    },
    "path": {
      "$ref": "#/$defs/OpPath",
      "description": "Operator path (OpPath)."
    },
    "pid": {
      "$ref": "#/$defs/Pid",
      "description": "Target pid."
    }
  },
  "required": [
    "pid",
    "path"
  ],
  "type": "object"
}
