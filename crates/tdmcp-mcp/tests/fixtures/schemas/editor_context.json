{
  "$defs": {
    "DiagnosticLevel": {
      "description": "Payload size for diagnostics (independent of structural `detailLevel`).",
      "oneOf": [
        {
          "const": "summary",
          "description": "Codes, messages, capped lints, mitigation.",
          "type": "string"
        },
        {
          "const": "detailed",
          "description": "Plus raw traceback / full TD dumps.",
          "type": "string"
        }
      ]
    },
    "Pid": {
      "anyOf": [
        {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        {
          "pattern": "^\\s*[0-9]+\\s*$",
          "type": "string"
        }
      ],
      "description": "OS process id — sole address for tools and queues."
    }
  },
  "additionalProperties": false,
  "description": "Args for `editor_context`.",
  "properties": {
    "daemonId": {
      "default": null,
      "description": "Optional federated daemon id (omit for local / unique remote resolve).",
      "type": [
        "string",
        "null"
      ]
    },
    "diagnosticLevel": {
      "$ref": "#/$defs/DiagnosticLevel",
      "default": "summary",
      "description": "Diagnostic payload size (`summary` omits raw traceback)."
    },
    "pid": {
      "$ref": "#/$defs/Pid",
      "description": "Target pid."
    }
  },
  "required": [
    "pid"
  ],
  "type": "object"
}
