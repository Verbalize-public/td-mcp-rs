{
  "$defs": {
    "KillMode": {
      "description": "Kill mode.",
      "oneOf": [
        {
          "const": "graceful",
          "description": "Post WM_CLOSE and wait; surfaces popups if it lingers.",
          "type": "string"
        },
        {
          "const": "force",
          "description": "Terminate unconditionally.",
          "type": "string"
        }
      ]
    },
    "LenientU64": {
      "anyOf": [
        {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        {
          "pattern": "^\\s*[0-9]+\\s*$",
          "type": "string"
        }
      ],
      "description": "Unsigned 64-bit integer; accepts a JSON number or a decimal numeric string."
    },
    "Pid": {
      "anyOf": [
        {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        {
          "pattern": "^\\s*[0-9]+\\s*$",
          "type": "string"
        }
      ],
      "description": "OS process id — sole address for tools and queues."
    }
  },
  "additionalProperties": false,
  "description": "Args for `kill_td`.",
  "properties": {
    "graceMs": {
      "$ref": "#/$defs/LenientU64",
      "default": 5000,
      "description": "Grace window for graceful mode (ms)."
    },
    "mode": {
      "$ref": "#/$defs/KillMode",
      "description": "`graceful` (close windows / SIGTERM + grace window) or `force`."
    },
    "pid": {
      "$ref": "#/$defs/Pid",
      "description": "Target pid."
    }
  },
  "required": [
    "pid"
  ],
  "type": "object"
}
