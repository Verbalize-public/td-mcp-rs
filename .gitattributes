# TouchDesigner project-io artifacts are byte-sensitive: toc files and .text sidecar
# samples are strict-LF (CRLF makes toecollapse emit silent empty output).
*.toc text eol=lf
fixtures/v2-probes/**/*.bin -text
# TD packed binaries are opaque - never normalize
*.toe -text
*.tox -text
# Probe backup artifacts (created by project_install_bridge) stay opaque
fixtures/v2-probes/**/*.bak -text
# License inventories contain hashes of exact upstream bytes. Windows checkout
# must not rewrite those records or their canonical fallback texts to CRLF.
/third-party/generated/** -text
/third-party/canonical/** -text
# The inventory also records the exact lockfile digest.
/Cargo.lock text eol=lf
